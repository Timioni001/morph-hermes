# MORPH environment template.
#
# MORPH holds no credentials of its own: a connector names an environment variable
# and Hermes resolves it for the active profile (agent.secret_scope.get_secret), so
# these belong in the Hermes profile environment — ~/.hermes/.env — not in a file
# inside the plugin.
#
# The three variables below are the bundled demo applications. If they are unset,
# each service generates its own token on first start and keeps it beside its
# database (0600); `python -m apps.serve --print-tokens` shows them.

# Bearer token for the Storefront demo application (http://127.0.0.1:8811)
MORPH_STOREFRONT_TOKEN=

# Bearer token for the Helpdesk demo application (http://127.0.0.1:8812)
MORPH_HELPDESK_TOKEN=

# Bearer token for the Warehouse demo application (http://127.0.0.1:8813)
MORPH_WAREHOUSE_TOKEN=

# ── optional ─────────────────────────────────────────────────────────────────
# Where MORPH keeps its own state (workspaces, proposals, audit log).
# Defaults to <hermes home>/plugin-data/morph/.
# MORPH_DATA_DIR=

# Point MORPH at your own connector wiring instead of the bundled default.
# MORPH_CONFIG_FILE=/etc/morph/connectors.json
# MORPH_CONFIG={"connectors":[...]}

# Where the bundled demo applications keep their databases and generated tokens.
# MORPH_DEMO_DATA_DIR=~/.morph-demo
